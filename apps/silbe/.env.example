# Shopify Storefront API (Phase 1+)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=z9xkt0-2v.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Payload (Phase 0)
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=
DATABASE_URI=

# Klaviyo (Phase 5)
KLAVIYO_API_KEY=
KLAVIYO_NEWSLETTER_LIST_ID=

# Cookiebot (Phase 6)
COOKIEBOT_DOMAIN_GROUP_ID=

# Gelato (Phase 7)
GELATO_API_KEY=
GELATO_STORE_ID=

# Shopify Admin (Phase 3 metafield seed + Phase 7 webhooks).
# Per 2026-01 Shopify auth migration: no more static admin tokens. Apps in
# the Dev Dashboard get Client ID + Client Secret; tokens are minted via
# OAuth Client Credentials Grant against /admin/oauth/access_token and
# expire after 24h. SHOPIFY_SHOP is the bare subdomain (e.g. "z9xkt0-2v"),
# NOT the .myshopify.com domain.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
