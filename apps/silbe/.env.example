# Shopify Storefront API (Phase 1+)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=z9xkt0-2v.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Payload (Phase 0)
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=
DATABASE_URI=

# Klaviyo (Phase 5) — Newsletter signup ("Briefe von SILBE").
# Double-Opt-In wird in Klaviyo pro Liste konfiguriert (Lists & Segments →
# <list> → Settings → Opt-in Process = Double opt-in). Sobald die Liste
# auf DOI steht, sendet Klaviyo automatisch die Bestätigungs-E-Mail.
KLAVIYO_PRIVATE_KEY=
NEXT_PUBLIC_KLAVIYO_LIST_ID=

# Consent (Phase 10 step 1) — Shopify Customer Privacy API in headless mode.
# The API script (loaded by ConsentProvider) needs three values to write the
# decision back to Shopify; without all three setTrackingConsent silently
# no-ops, so ConsentProvider refuses to open the banner unless all are set.
#
# - NEXT_PUBLIC_SILBE_CONSENT_STOREFRONT_DOMAIN — root host of the storefront
#   the visitor is currently on (e.g. "brainsells-headless.vercel.app" until
#   the Phase 11 DNS switch, "silbe.at" thereafter). Used by Shopify to scope
#   the consent cookie.
# - NEXT_PUBLIC_SILBE_CONSENT_CHECKOUT_DOMAIN — root host of the Shopify-hosted
#   checkout (the domain in cart.checkoutUrl). Used by Shopify to mirror the
#   consent decision to the checkout context.
# - NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN (above) — reused as the access token.
NEXT_PUBLIC_SILBE_CONSENT_STOREFRONT_DOMAIN=
NEXT_PUBLIC_SILBE_CONSENT_CHECKOUT_DOMAIN=

# Tracking (Phase 10 step 2) — WEB-GTM container id (GTM-…). This is the
# BROWSER container that receives dataLayer pushes; it forwards server-side
# to the Stape sGTM container via its own settings (Dashboard, Schritt 3) —
# the Stape/server container id never appears in code. Unset = GTM stays
# off entirely (no script load, no pushes); the consent banner and Consent
# Mode defaults still work. Prod value: GTM-5WFZNXMZ.
NEXT_PUBLIC_GTM_ID=

# GA4 Measurement Protocol (server-side `refund` event from the refunds/create
# webhook). NOT public — these are server-only and must never reach the client.
# - GA4_MEASUREMENT_ID — the GA4 Web data-stream id (G-…). Prod: G-Z06HHP6EFM.
# - GA4_API_SECRET — Measurement Protocol API secret for that stream (GA4 Admin
#   → Data Streams → <stream> → Measurement Protocol API secrets). SAME secret
#   the purchase Web-Pixel uses. Set interactively / in Vercel; never commit it,
#   never log it (it is sent as a query param on the collect URL).
# Validate the payload against /debug/mp/collect first:
#   pnpm tsx scripts/validate-refund-mp.ts
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# orders/paid → server-side GA4 `purchase` via Stape (gtag /g/collect). The Stape
# send needs no api_secret. GA4_PURCHASE_DEBUG=1 adds _dbg=1 so a verification run
# lands in GA4 DebugView (e.g. to confirm item_variant). Unset/0 for prod.
GA4_PURCHASE_DEBUG=

# Gelato (Phase 7)
GELATO_API_KEY=
GELATO_STORE_ID=

# Shopify Admin (Phase 3 metafield seed + Phase 7 webhooks + Phase 9
# Sprint-B orders/create webhook).
# Per 2026-01 Shopify auth migration: no more static admin tokens. Apps in
# the Dev Dashboard get Client ID + Client Secret; tokens are minted via
# OAuth Client Credentials Grant against /admin/oauth/access_token and
# expire after 24h. SHOPIFY_SHOP is the bare subdomain (e.g. "z9xkt0-2v"),
# NOT the .myshopify.com domain.
#
# SHOPIFY_CLIENT_SECRET is also the HMAC signing key for orders/create
# webhook callbacks — programmatically registered subscriptions (Sprint-B
# scripts/register-webhooks.ts) are signed with the App Client-Secret, so
# no separate SHOPIFY_WEBHOOK_SECRET is needed.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Widerruf (Sprint merlin/widerruf-button-sprint) — § 356a BGB elektronische
# Widerrufsfunktion. Signs the magic-link / form-redirect token that proves
# the lookup happened server-side before the confirm step. Generate with
# `openssl rand -hex 32` (32 bytes → 64 hex chars). Rotation invalidates
# in-flight tokens (max 14d) — out-of-scope for this sprint.
WIDERRUF_TOKEN_SECRET=

# Internal alert address for the Widerruf-Alert-Intern Klaviyo event. When set,
# submitWiderrufAction fires a second fail-soft event to this profile so the
# team flow ("Widerruf Alert Intern") delivers an internal notification (Gelato
# canceln, Refund anstoßen). Unset = no alert, no error. Provisioned in Vercel.
WIDERRUF_ALERT_EMAIL=
