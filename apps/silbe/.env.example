# Shopify Storefront API (Phase 1+)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=z9xkt0-2v.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Payload (Phase 0)
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=
DATABASE_URI=

# Klaviyo (Phase 5) — Newsletter signup ("Briefe von SILBE").
# Double-Opt-In wird in Klaviyo pro Liste konfiguriert (Lists & Segments →
# <list> → Settings → Opt-in Process = Double opt-in). Sobald die Liste
# auf DOI steht, sendet Klaviyo automatisch die Bestätigungs-E-Mail.
KLAVIYO_PRIVATE_KEY=
NEXT_PUBLIC_KLAVIYO_LIST_ID=

# Consent (Phase 10 step 1) — Shopify Customer Privacy API in headless mode.
# The API script (loaded by ConsentProvider) needs three values to write the
# decision back to Shopify; without all three setTrackingConsent silently
# no-ops, so ConsentProvider refuses to open the banner unless all are set.
#
# - NEXT_PUBLIC_SILBE_CONSENT_STOREFRONT_DOMAIN — root host of the storefront
#   the visitor is currently on (e.g. "brainsells-headless.vercel.app" until
#   the Phase 11 DNS switch, "silbe.at" thereafter). Used by Shopify to scope
#   the consent cookie.
# - NEXT_PUBLIC_SILBE_CONSENT_CHECKOUT_DOMAIN — root host of the Shopify-hosted
#   checkout (the domain in cart.checkoutUrl). Used by Shopify to mirror the
#   consent decision to the checkout context.
# - NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN (above) — reused as the access token.
NEXT_PUBLIC_SILBE_CONSENT_STOREFRONT_DOMAIN=
NEXT_PUBLIC_SILBE_CONSENT_CHECKOUT_DOMAIN=

# Tracking (Phase 10 step 2) — WEB-GTM container id (GTM-…). This is the
# BROWSER container that receives dataLayer pushes; it forwards server-side
# to the Stape sGTM container via its own settings (Dashboard, Schritt 3) —
# the Stape/server container id never appears in code. Unset = GTM stays
# off entirely (no script load, no pushes); the consent banner and Consent
# Mode defaults still work. Prod value: GTM-5WFZNXMZ.
NEXT_PUBLIC_GTM_ID=

# GA4 Measurement Protocol (server-side `refund` event from the refunds/create
# webhook). NOT public — these are server-only and must never reach the client.
# - GA4_MEASUREMENT_ID — the GA4 Web data-stream id (G-…). Prod: G-Z06HHP6EFM.
# - GA4_API_SECRET — Measurement Protocol API secret for that stream (GA4 Admin
#   → Data Streams → <stream> → Measurement Protocol API secrets). SAME secret
#   the purchase Web-Pixel uses. Set interactively / in Vercel; never commit it,
#   never log it (it is sent as a query param on the collect URL).
# Validate the payload against /debug/mp/collect first:
#   pnpm tsx scripts/validate-refund-mp.ts
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# orders/paid → server-side GA4 `purchase` via Stape (gtag /g/collect). The Stape
# send needs no api_secret. GA4_PURCHASE_DEBUG=1 adds _dbg=1 so a verification run
# lands in GA4 DebugView (e.g. to confirm item_variant). Unset/0 for prod.
GA4_PURCHASE_DEBUG=

# Brand-config layer (Blueprint Block A) — per-shop values read via lib/brand.config
# with fail-fast (a missing var throws on first use, never a silent fallback). ALL
# must be set in Vercel (Preview + Prod) BEFORE deploying, or the orders/paid +
# orders/create webhooks 500 on the throw.
# - STAPE_SERVER_BASE — EU Stape server-container base the purchase gtag /g/collect
#   POSTs to (no trailing slash). Free tier serves EU egress only. Prod:
#   https://ctsqyrwh.eus.stape.net
# - GTAG_GTM_FINGERPRINT — gtag `gtm=` fingerprint from the verified green Stufe-0
#   hit; pins the wire format the Stape server tags expect. Prod: 45je
# - MARKER_NAMESPACE — Shopify Order metafield namespace for the GA4 purchase
#   idempotency marker (`<namespace>.ga4_purchase_sent`). Prod: silbe
# - KLAVIYO_EDITORIAL_EVENT — Klaviyo custom-event name fired by the dormant
#   orders/create editorial path; must match the Klaviyo Flow trigger exactly.
#   Prod: Bestellung Editorial
STAPE_SERVER_BASE=
GTAG_GTM_FINGERPRINT=
MARKER_NAMESPACE=
KLAVIYO_EDITORIAL_EVENT=

# Per-platform CAPI test_event_code (Stufe 2 verification). When set, the purchase
# carries bs_test_<platform> → the Stape tag routes that platform's event to its
# Test-Events tab instead of prod reporting. Set exactly ONE at a time to keep the
# Meta → TikTok → Pinterest sequence serial; UNSET all in prod (a leftover value
# routes real conversions to the Test tab = undercount). The code warn-logs when
# any is active. Values come from each platform's Events Manager / Test-Events tool.
META_TEST_EVENT_CODE=
TIKTOK_TEST_EVENT_CODE=
PINTEREST_TEST_EVENT_CODE=

# Gelato (Phase 7) — ENTFERNT 2026-08-10.
# GELATO_API_KEY und GELATO_STORE_ID standen hier ohne einen einzigen Leser im
# Code: Phase 7 wurde nie gebaut, SILBEs Gelato-Anbindung läuft auf
# Shopify-App-Ebene. Tote Config ist schlimmer als fehlende — sie suggeriert einem
# Fork, hier sei etwas zu konfigurieren, und verdeckt, dass die Integration gar
# nicht existiert. Das Layer-1-Fulfillment-Interface (lib/fulfillment) hat eigene
# Keys weiter unten.

# --- Brand-Identität (Block A) ----------------------------------------------

# Origin dieser Brand, ohne abschließenden Slash — z. B. https://deine-brand.at
# Speist Sitemap, robots.txt und JSON-LD über lib/seo/canonical-url.ts.
#
# Der Key fehlte in dieser Datei komplett, obwohl der Code ihn liest: ein Fork
# konnte nicht wissen, dass es ihn gibt, und lief still in SILBEs Origin.
#
# ⚠️ PFLICHT ZUR BUILD-ZEIT, fail-fast. Fehlt der Wert, bricht `next build` —
# beabsichtigt: eine Storefront, die ihren eigenen Origin nicht kennt, soll keine
# fremden canonical-URLs ausliefern. Speist BEIDE Oberflächen aus einer Quelle
# (brandConfig.site.origin): Sitemap/robots/JSON-LD über canonical-url.ts und
# canonical/OG/Twitter jeder Seite über metadataBase in layout.tsx.
#
# ⚠️ Muss ZUSÄTZLICH in turbo.json unter tasks.build.env stehen. turbo läuft mit
# envMode=strict und entfernt undeklarierte Variablen aus der Build-Umgebung — der
# Wert wäre sonst in Vercel gesetzt und trotzdem wirkungslos. Genau so ist Gap #10
# entstanden.
METADATA_BASE_URL=

# Runtime-only, lazy über lib/brand.config.ts gelesen.

# Shopify-Metafield-Namespace für den EDITORIAL-Content-Vertrag (author_handle,
# work_title, quote_full, editorial_context …). Bei SILBE ist das 'silbe' — und
# genau deshalb war es doppeldeutig: MARKER_NAMESPACE (Purchase-Idempotenz) trug
# zufällig denselben Wert. Zwei unabhängige Verträge, die ein Fork verschieden
# setzen können darf.
EDITORIAL_METAFIELD_NAMESPACE=

# Attributions-String auf Newsletter-Anmeldungen (Klaviyo `custom_source`). War
# als 'silbe.at footer' hartkodiert — ein Fork erbte SILBEs Attribution und konnte
# seine eigenen Anmeldungen in Klaviyo nicht unterscheiden.
KLAVIYO_NEWSLETTER_SOURCE=

# --- Layer-1 Fulfillment-Interface (lib/fulfillment) -------------------------
# Runtime-only. NONE of these are required at build time: brand.config reads them
# through lazy getters and the provider registry instantiates providers on first
# use, so `next build` and vitest import these modules without any of them set.
#
# NOT wired into SILBE's live fulfillment — SILBE's prints run through the Gelato
# Shopify app and its tote bags through Printful on app level, neither via this code.

# Which provider handles a line item that carries no explicit override, and which
# providers this brand is allowed to use at all (comma-separated allowlist).
# A provider named by a product metafield but absent here is refused by the router.
FULFILLMENT_DEFAULT_PROVIDER=
FULFILLMENT_ENABLED_PROVIDERS=

# FACTORY LEVEL — one account-wide Printful token shared across all brands.
# Printful Dashboard → Settings → Developers → add a private token. Account scope,
# NOT store-scoped: the same token reaches every store on the account, which is
# exactly why the store id below has to be explicit.
# Server-only. Do NOT give this a NEXT_PUBLIC_ prefix — a public prefix inlines the
# value into the client bundle, where anyone could place orders on our account.
PRINTFUL_API_TOKEN=

# PER BRAND — the Printful store this brand's orders belong to, sent as the
# X-PF-Store-Id header. Discover it via `GET https://api.printful.com/v2/stores`
# and write the id down here explicitly. Never let code pick "the only" or "the
# first" store: the account carries several (verified 2026-08-06), so a positional
# pick sends a brand's orders to another brand's store.
PRINTFUL_STORE_ID=

# Shared secret for verifying Printful webhooks. UNSET = every Printful webhook is
# rejected, by design: the signing scheme (header name, algorithm, signed bytes) is
# not yet confirmed against a real delivery, and an endpoint that accepts anything
# is worse than one that accepts nothing. Confirm the scheme before enabling.
PRINTFUL_WEBHOOK_SECRET=

# Shopify Admin (Phase 3 metafield seed + Phase 7 webhooks + Phase 9
# Sprint-B orders/create webhook).
# Per 2026-01 Shopify auth migration: no more static admin tokens. Apps in
# the Dev Dashboard get Client ID + Client Secret; tokens are minted via
# OAuth Client Credentials Grant against /admin/oauth/access_token and
# expire after 24h. SHOPIFY_SHOP is the bare subdomain (e.g. "z9xkt0-2v"),
# NOT the .myshopify.com domain.
#
# SHOPIFY_CLIENT_SECRET — OAuth client secret for the client_credentials admin
# token mint (Phase-9 Sprint-B). NOTE (2026-06): it was ASSUMED to also be the
# webhook HMAC signing secret, but real Shopify deliveries 401'd against it →
# Shopify signs webhooks with a DIFFERENT secret. Set SHOPIFY_WEBHOOK_SECRET to
# the actual webhook signing secret (verify falls back to SHOPIFY_CLIENT_SECRET
# when it is unset). See memory shopify-webhook-hmac-secret-mismatch.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Webhook HMAC signing secret — the value Shopify actually signs webhook
# callbacks with (2026-06: the "Old" client secret, NOT the current one). Verify
# is rotation-safe: it accepts a match against ANY of SHOPIFY_WEBHOOK_SECRET,
# SHOPIFY_WEBHOOK_SECRET_OLD, or SHOPIFY_CLIENT_SECRET. So set this to the signing
# secret and leave SHOPIFY_CLIENT_SECRET on the current OAuth/mint secret.
SHOPIFY_WEBHOOK_SECRET=
# Diagnostics (temporary): SHOPIFY_HMAC_DEBUG=1 logs received-vs-computed HMAC for
# each candidate secret env on a verify failure (NO secret/PII logged) so one real
# delivery reveals which secret matches. SHOPIFY_WEBHOOK_SECRET_OLD is an extra
# candidate (e.g. a rotated Old secret) tested alongside the New one.
SHOPIFY_HMAC_DEBUG=
SHOPIFY_WEBHOOK_SECRET_OLD=

# Widerruf (Sprint merlin/widerruf-button-sprint) — § 356a BGB elektronische
# Widerrufsfunktion. Signs the magic-link / form-redirect token that proves
# the lookup happened server-side before the confirm step. Generate with
# `openssl rand -hex 32` (32 bytes → 64 hex chars). Rotation invalidates
# in-flight tokens (max 14d) — out-of-scope for this sprint.
WIDERRUF_TOKEN_SECRET=

# Internal alert address for the Widerruf-Alert-Intern Klaviyo event. When set,
# submitWiderrufAction fires a second fail-soft event to this profile so the
# team flow ("Widerruf Alert Intern") delivers an internal notification (Gelato
# canceln, Refund anstoßen). Unset = no alert, no error. Provisioned in Vercel.
WIDERRUF_ALERT_EMAIL=
